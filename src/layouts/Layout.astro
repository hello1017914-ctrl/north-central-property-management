---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "North Central Property Management | Lawn Care, Cleanups, Gutter Cleaning & Animal Damage Control",
  description = "North Central Property Management provides professional lawn care, spring and fall cleanup, gutter cleaning, and animal damage control in Central Michigan. Call 989-259-8499 for a free estimate."
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Preload Hero Image for Instant Above-the-Fold Loading -->
    <link rel="preload" as="image" href="/images/hero.jpg" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-primary: #173715;
    --color-primary-dark: #0f240e;
    --color-primary-light: #234d1f;
    --color-accent: #5aa428;
    --color-accent-light: #6dbf33;
    --color-accent-hover: #48871e;
    --color-accent-glow: rgba(90, 164, 40, 0.25);
    
    --color-badge-bg: #ebf6e6;
    --color-badge-border: #d4ebd0;
    --color-badge-text: #2d6318;
    
    --color-white: #ffffff;
    --color-bg-light: #f7faf6;
    --color-bg-subtle: #f1f6f0;
    --color-card-border: #e3ede1;
    
    --color-text: #192618;
    --color-text-muted: #556653;
    --color-text-subtle: #798d77;
    
    --color-veteran-red: #c92a2a;
    --color-veteran-blue: #1c4b82;

    --font-heading: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-body: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;

    --radius-sm: 8px;
    --radius-md: 14px;
    --radius-lg: 20px;
    --radius-xl: 28px;
    --radius-full: 9999px;

    --shadow-sm: 0 2px 8px rgba(23, 55, 21, 0.06);
    --shadow-md: 0 10px 25px -4px rgba(23, 55, 21, 0.09), 0 4px 10px -2px rgba(23, 55, 21, 0.04);
    --shadow-lg: 0 20px 40px -8px rgba(23, 55, 21, 0.14), 0 8px 16px -4px rgba(23, 55, 21, 0.06);
    --shadow-xl: 0 30px 60px -12px rgba(15, 36, 14, 0.22);
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    font-size: 16px;
    background-color: var(--color-white);
    color: var(--color-text);
  }

  body {
    font-family: var(--font-body);
    line-height: 1.6;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  a {
    color: inherit;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  button, input, select, textarea {
    font-family: inherit;
  }

  /* Universal Pill Badge Component */
  .section-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: var(--color-badge-bg);
    color: var(--color-badge-text);
    border: 1px solid var(--color-badge-border);
    padding: 6px 16px;
    border-radius: var(--radius-full);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 16px;
  }

  .section-badge svg {
    width: 16px;
    height: 16px;
    color: var(--color-accent);
  }

  /* Universal Buttons */
  .btn-pill-green {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background-color: var(--color-accent);
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 700;
    padding: 14px 28px;
    border-radius: var(--radius-full);
    border: 2px solid var(--color-accent);
    cursor: pointer;
    box-shadow: 0 6px 18px var(--color-accent-glow);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    text-decoration: none;
    white-space: nowrap;
  }

  .btn-pill-green:hover {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(72, 135, 30, 0.35);
  }

  .btn-pill-white {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background-color: var(--color-white);
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 700;
    padding: 14px 28px;
    border-radius: var(--radius-full);
    border: 2px solid var(--color-white);
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    text-decoration: none;
    white-space: nowrap;
  }

  .btn-pill-white:hover {
    background-color: rgba(255, 255, 255, 0.9);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
  }

  .container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Universal section styling */
  .section {
    padding: 85px 0;
  }

  .section-title {
    font-size: clamp(28px, 3.8vw, 42px);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-primary);
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  /* Utility classes */
  .text-accent {
    color: var(--color-accent);
  }
</style>
