---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ServiceCard from '../components/ServiceCard.astro';

// Local high-fidelity images
const images = {
  hero: "/images/hero.jpg",
  about1: "/images/about-main.jpg",
  about2: "/images/about-secondary.jpg",
  howItWorks: "/images/service-lawn-care.jpg",
  // The 4 exact flyer services
  lawnCare: "/images/service-lawn-care.jpg",
  cleanup: "/images/service-cleanup.jpg",
  gutterCleaning: "/images/gutter-cleaning.jpg",
  animalDamage: "/images/animal-damage-control.jpg",
  // Gallery
  gallery1: "/images/service-lawn-care.jpg",
  gallery2: "/images/gutter-cleaning.jpg",
  gallery3: "/images/service-cleanup.jpg",
  gallery4: "/images/animal-damage-control.jpg",
};
---

<Layout 
  title="North Central Property Management | Lawn Care, Cleanups, Gutter Cleaning & Animal Damage Control"
  description="North Central Property Management provides expert lawn care, spring/fall cleanups, gutter cleaning, and animal damage control. Call (989) 259-8499 for a free estimate."
>
  <Header currentPage="home" />

  <main>
    <!-- HERO SECTION -->
    <section class="hero-wrap">
      <div class="hero-bg" style={`background-image: linear-gradient(rgba(15, 36, 14, 0.78), rgba(15, 36, 14, 0.88)), url('${images.hero}')`}>
        <div class="container hero-container">
          <div class="hero-content">
            <!-- Pill Tag -->
            <div class="hero-pill">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z"/>
              </svg>
              <span>NORTH CENTRAL PROPERTY MANAGEMENT &bull; QUALITY WORK YOU CAN COUNT ON</span>
            </div>

            <!-- Big Bold Punchy Headline -->
            <h1 class="hero-headline">
              COMPLETE PROPERTY CARE &amp; EXTERIOR MAINTENANCE SOLUTIONS
            </h1>

            <!-- Subheading / Copy -->
            <p class="hero-subheading">
              At North Central Property Management, we deliver dependable, professional outdoor care tailored to residential and commercial properties throughout Central Michigan. From lush lawn care and seasonal cleanups to thorough gutter cleaning and animal damage control.
            </p>

            <!-- Hero Action Buttons -->
            <div class="hero-actions">
              <a href="#quote-section" class="btn-pill-green">
                <span>REQUEST YOUR FREE QUOTE</span>
                <span class="btn-arrow">&rarr;</span>
              </a>
              <a href="tel:989-259-8499" class="btn-pill-white">
                <span>CALL (989) 259-8499</span>
                <span class="btn-arrow">&rarr;</span>
              </a>
            </div>

            <!-- Trust Badge Highlights matching the flyer pillars -->
            <div class="hero-trust-row">
              <div class="trust-badge-item">
                <div class="trust-check">🌲</div>
                <span>Reliable Service</span>
              </div>
              <div class="trust-badge-item">
                <div class="trust-check">🤝</div>
                <span>Affordable Rates</span>
              </div>
              <div class="trust-badge-item">
                <div class="trust-check">👍</div>
                <span>Quality Work You Can Count On</span>
              </div>
              <div class="trust-badge-item veteran-highlight">
                <div class="trust-check">📞</div>
                <span>Free Estimates</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- OVERLAPPING FLOATING QUOTE BAR -->
      <div class="container quote-card-wrapper" id="quote-section">
        <div class="quote-card">
          <div class="quote-card-header">
            <div class="quote-badge">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M17 8C8 10 5 19 5 19C5 19 14 19 19 14C20.5 12.5 21 9 21 8C20 8 18 8 17 8Z" />
              </svg>
              <span>GET A FREE PROPERTY MANAGEMENT QUOTE</span>
            </div>
            <span class="quote-header-note">Free Estimates &bull; Call (989) 259-8499</span>
          </div>

          <form class="quote-form" id="home-quote-form">
            <div class="form-inputs-grid">
              <div class="input-field">
                <input type="text" name="name" id="quote-name" placeholder="Full Name" required />
              </div>
              <div class="input-field">
                <input type="email" name="email" id="quote-email" placeholder="Email Address" required />
              </div>
              <div class="input-field">
                <input type="tel" name="phone" id="quote-phone" placeholder="Phone Number" required />
              </div>
              <div class="input-field">
                <select name="service" id="quote-service" required>
                  <option value="" disabled selected>Service Needed</option>
                  <option value="lawn-care">Lawn Care (Mowing, Trimming, Edging)</option>
                  <option value="cleanup">Spring / Fall Clean Up</option>
                  <option value="gutter-cleaning">Gutter Cleaning (Debris &amp; Downspouts)</option>
                  <option value="animal-damage-control">Animal Damage Control &amp; Exclusion</option>
                </select>
              </div>
              <div class="input-field message-field">
                <input type="text" name="message" id="quote-message" placeholder="Property Address / Project Details" required />
              </div>
              <div class="input-field submit-field">
                <button type="submit" class="btn-pill-green quote-submit-btn">
                  <span>GET FREE QUOTE</span>
                  <span class="btn-arrow">&rarr;</span>
                </button>
              </div>
            </div>
            <div class="quote-form-status" id="quote-status"></div>
          </form>
        </div>
      </div>
    </section>

    <!-- ABOUT SECTION -->
    <section class="section about-section">
      <div class="container about-grid">
        <!-- Left: Image Collage -->
        <div class="about-collage">
          <div class="about-img-main">
            <img src={images.about1} alt="North Central Property Management specialist mowing lawn" loading="lazy" />
          </div>
          <div class="about-img-secondary">
            <img src={images.about2} alt="Professional lawn edging and property care" loading="lazy" />
          </div>
        </div>

        <!-- Right: Text Content -->
        <div class="about-text-content">
          <div class="section-badge">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M17 8C8 10 5 19 5 19C5 19 14 19 19 14C20.5 12.5 21 9 21 8C20 8 18 8 17 8Z" />
            </svg>
            <span>About Us</span>
          </div>

          <h2 class="section-title">
            ABOUT NORTH CENTRAL PROPERTY MANAGEMENT<br />
            <span class="text-accent">YOUR TRUSTED OUTDOOR SPECIALISTS</span>
          </h2>

          <p class="about-lead">
            At North Central Property Management, we are dedicated to providing reliable, affordable, and high-quality property maintenance solutions for homeowners, landlords, and commercial properties throughout Central Michigan.
          </p>

          <p class="about-body">
            From precision weekly lawn mowing and seasonal spring and fall cleanups to thorough gutter cleaning and humane animal damage control &amp; repair, we keep your property well-protected and looking its absolute best in every season.
          </p>

          <!-- Checkmark Bullets -->
          <ul class="about-checklist">
            <li>
              <div class="check-circle">✓</div>
              <span><strong>Lawn Care:</strong> Precision mowing, clean edging, and trimming</span>
            </li>
            <li>
              <div class="check-circle">✓</div>
              <span><strong>Spring / Fall Clean Up:</strong> Complete leaf removal, bed cleanup, and seasonal prep</span>
            </li>
            <li>
              <div class="check-circle">✓</div>
              <span><strong>Gutter Cleaning:</strong> Debris removal, downspout flushing, and overflow prevention</span>
            </li>
            <li>
              <div class="check-circle">✓</div>
              <span><strong>Animal Damage Control:</strong> Entry repairs, humane wildlife exclusion, and damage prevention</span>
            </li>
            <li>
              <div class="check-circle highlight">⭐</div>
              <span><strong>Customer Commitment:</strong> Prompt communication, fair pricing, and 100% satisfaction guaranteed</span>
            </li>
          </ul>

          <div class="about-cta-wrap">
            <a href="/estimate" class="btn-pill-green">
              <span>REQUEST YOUR FREE QUOTE</span>
              <span class="btn-arrow">&rarr;</span>
            </a>
            <a href="tel:989-259-8499" class="about-phone-link">
              <span class="phone-circle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.64-3.97 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.97-8.64A2 2 0 018.1 5.24l3 3a2 2 0 01.21 2.97z"/></svg>
              </span>
              <div>
                <span class="call-sub">Free Estimates &bull; Call</span>
                <strong>(989) 259-8499</strong>
              </div>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- CORE SERVICES SECTION -->
    <section class="section services-section">
      <div class="container">
        <div class="services-header-row">
          <div>
            <div class="section-badge">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M17 8C8 10 5 19 5 19C5 19 14 19 19 14C20.5 12.5 21 9 21 8C20 8 18 8 17 8Z" />
              </svg>
              <span>Our Core Services</span>
            </div>
            <h2 class="section-title">EXPERT PROPERTY CARE &amp; MAINTENANCE</h2>
          </div>

          <div class="services-nav-controls">
            <a href="/services" class="btn-view-all">
              <span>View All Services</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

        <div class="services-grid">
          <!-- 1. LAWN CARE -->
          <ServiceCard 
            title="Lawn Care"
            description="Complete turf care keeping residential and commercial lawns immaculate, healthy, and sharp all season."
            imageSrc={images.lawnCare}
            altText="Lawn mowing service in progress"
            link="/services#lawn-care"
            features={["Precision Mowing", "Perimeter Trimming", "Walkway Edging"]}
            themeColor="green"
            iconType="lawn"
          />

          <!-- 2. SPRING / FALL CLEAN UP -->
          <ServiceCard 
            title="Spring / Fall Clean Up"
            description="Thorough seasonal cleanup, leaf vacuuming, yard waste hauling, and bed preparation for optimal property health."
            imageSrc={images.cleanup}
            altText="Spring and fall cleanup with leaves and raking"
            link="/services#cleanup"
            features={["Leaf Removal", "Brush Cleanup", "Property Cleanups"]}
            themeColor="orange"
            iconType="cleanup"
          />

          <!-- 3. GUTTER CLEANING -->
          <ServiceCard 
            title="Gutter Cleaning"
            description="Professional gutter and downspout cleaning preventing water pooling, roof rot, and foundation seepage."
            imageSrc={images.gutterCleaning}
            altText="Technician cleaning gutters safely"
            link="/services#gutter-cleaning"
            features={["Debris Removal", "Downspout Clearing", "Water Flow Testing"]}
            themeColor="blue"
            iconType="snow"
          />

          <!-- 4. ANIMAL DAMAGE CONTROL -->
          <ServiceCard 
            title="Animal Damage Control"
            description="Humane wildlife exclusion, soffit and fascia repairs, and entry prevention against raccoons, rodents, and pests."
            imageSrc={images.animalDamage}
            altText="Animal damage repair and wildlife exclusion"
            link="/services#animal-damage-control"
            features={["Humane Exclusion", "Damage Repair", "Barrier Installation"]}
            themeColor="emerald"
            iconType="debris"
          />
        </div>
      </div>
    </section>

    <!-- STEP-BY-STEP / HOW IT WORKS SECTION -->
    <section class="section how-it-works-section">
      <div class="container how-grid">
        <!-- Left: Pitch + Image -->
        <div class="how-left">
          <div class="section-badge">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M17 8C8 10 5 19 5 19C5 19 14 19 19 14C20.5 12.5 21 9 21 8C20 8 18 8 17 8Z" />
            </svg>
            <span>How It Works</span>
          </div>

          <h2 class="section-title">
            STEP-BY-STEP SERVICE<br />
            WITH NORTH CENTRAL PROPERTY MANAGEMENT
          </h2>

          <p class="how-lead">
            Our process is simple and hassle-free, ensuring your property stays clean, safe, and beautiful without unexpected complications.
          </p>

          <a href="/estimate" class="btn-pill-green how-btn">
            <span>START YOUR SERVICE</span>
            <span class="btn-arrow">&rarr;</span>
          </a>

          <div class="how-image-box">
            <img src={images.howItWorks} alt="Technician working on lawn care" loading="lazy" />
          </div>
        </div>

        <!-- Right: Vertical Timeline Steps -->
        <div class="how-right">
          <div class="steps-timeline">
            <!-- Step 1 -->
            <div class="timeline-step">
              <div class="step-marker">
                <span class="marker-dot"></span>
                <span class="marker-line"></span>
              </div>
              <div class="step-card">
                <span class="step-pill">STEP 01</span>
                <h3 class="step-title">REQUEST A FREE ESTIMATE</h3>
                <p class="step-description">
                  Simply contact us to share the details of your lawn or property and request a free estimate. We provide upfront, transparent pricing.
                </p>
              </div>
            </div>

            <!-- Step 2 -->
            <div class="timeline-step">
              <div class="step-marker">
                <span class="marker-dot"></span>
                <span class="marker-line"></span>
              </div>
              <div class="step-card">
                <span class="step-pill">STEP 02</span>
                <h3 class="step-title">SCHEDULE YOUR SERVICE</h3>
                <p class="step-description">
                  Choose a convenient date and time for our professional team to visit your property. We arrive promptly and ready to work.
                </p>
              </div>
            </div>

            <!-- Step 3 -->
            <div class="timeline-step">
              <div class="step-marker">
                <span class="marker-dot"></span>
              </div>
              <div class="step-card">
                <span class="step-pill">STEP 03</span>
                <h3 class="step-title">ENJOY A BEAUTIFUL PROPERTY</h3>
                <p class="step-description">
                  We perform expert lawn care, seasonal cleanups, gutter clearing, and animal exclusion, leaving your property immaculate.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PORTFOLIO / GALLERY SECTION -->
    <section class="section gallery-section">
      <div class="container">
        <div class="gallery-header text-center">
          <div class="section-badge">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M17 8C8 10 5 19 5 19C5 19 14 19 19 14C20.5 12.5 21 9 21 8C20 8 18 8 17 8Z" />
            </svg>
            <span>Our Project Gallery</span>
          </div>
          <h2 class="section-title">
            OUR PORTFOLIO OF EXCELLENCE<br />
            <span class="text-accent">QUALITY WORK YOU CAN COUNT ON</span>
          </h2>
          <p class="gallery-subtitle">
            Take a look at some of our recent lawn care, gutter clearing, animal damage repair, and cleanup work.
          </p>
        </div>

        <div class="gallery-bento-grid">
          <div class="gallery-item item-1">
            <img src={images.gallery1} alt="Clean striping lawn mowing project" loading="lazy" />
            <div class="gallery-overlay">
              <span class="gallery-cat">Lawn Care</span>
              <h4 class="gallery-name">Precision Striped Turf</h4>
            </div>
          </div>
          <div class="gallery-item item-2">
            <img src={images.gallery2} alt="Gutter cleaning and debris removal" loading="lazy" />
            <div class="gallery-overlay">
              <span class="gallery-cat">Gutter Cleaning</span>
              <h4 class="gallery-name">Downspout &amp; Eaves Clearing</h4>
            </div>
          </div>
          <div class="gallery-item item-3">
            <img src={images.gallery3} alt="Spring and fall cleanup leaves and yard waste" loading="lazy" />
            <div class="gallery-overlay">
              <span class="gallery-cat">Seasonal Cleanup</span>
              <h4 class="gallery-name">Complete Leaf &amp; Yard Cleanup</h4>
            </div>
          </div>
          <div class="gallery-item item-4">
            <img src={images.gallery4} alt="Animal damage repair and humane exclusion" loading="lazy" />
            <div class="gallery-overlay">
              <span class="gallery-cat">Animal Damage Control</span>
              <h4 class="gallery-name">Humane Wildlife Exclusion &amp; Repair</h4>
            </div>
          </div>
        </div>

        <div class="gallery-cta text-center">
          <a href="/projects" class="btn-pill-green">
            <span>EXPLORE FULL PROJECT GALLERY</span>
            <span class="btn-arrow">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- PROMO BANNER -->
    <section class="veteran-promo-section">
      <div class="container veteran-promo-inner">
        <div class="promo-badge-tag">🌲 FREE ESTIMATES &bull; RELIABLE SERVICE</div>
        <h2 class="promo-title">READY TO ENHANCE YOUR PROPERTY?</h2>
        <p class="promo-text">
          North Central Property Management delivers quality work you can count on. Contact us today for your free estimate on lawn care, cleanups, gutter cleaning, or wildlife damage repairs.
        </p>
        <div class="promo-actions">
          <a href="/estimate" class="btn-pill-white">Request Free Estimate &rarr;</a>
          <a href="tel:989-259-8499" class="promo-call-link">
            <span>Call Today:</span>
            <strong>(989) 259-8499</strong>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ===================== HERO SECTION ===================== */
  .hero-wrap {
    position: relative;
    background-color: var(--color-primary-dark);
    margin-bottom: 90px;
  }

  .hero-bg {
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    padding: 90px 0 160px;
    position: relative;
  }

  .hero-container {
    position: relative;
    z-index: 2;
  }

  .hero-content {
    max-width: 860px;
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: 6px 18px;
    border-radius: var(--radius-full);
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 22px;
  }

  .hero-pill svg {
    width: 16px;
    height: 16px;
    color: var(--color-accent-light);
  }

  .hero-headline {
    font-family: var(--font-heading);
    font-size: clamp(34px, 5.2vw, 56px);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin-bottom: 22px;
    text-transform: uppercase;
  }

  .hero-subheading {
    font-size: clamp(16px, 1.8vw, 19px);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 34px;
    max-width: 740px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 36px;
  }

  .btn-arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .btn-pill-green:hover .btn-arrow,
  .btn-pill-white:hover .btn-arrow {
    transform: translateX(4px);
  }

  .hero-trust-row {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .trust-badge-item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.9);
    font-size: 14px;
    font-weight: 700;
  }

  .trust-badge-item.veteran-highlight {
    color: #ff9b9b;
  }

  .trust-check {
    font-size: 16px;
  }

  /* ===================== FLOATING QUOTE BAR ===================== */
  .quote-card-wrapper {
    position: relative;
    margin-top: -100px;
    z-index: 10;
  }

  .quote-card {
    background: var(--color-white);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
    padding: 30px 36px;
    border: 1px solid var(--color-card-border);
  }

  .quote-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 22px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .quote-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .quote-badge svg {
    width: 22px;
    height: 22px;
    color: var(--color-accent);
  }

  .quote-header-note {
    font-size: 13px;
    color: var(--color-accent);
    font-weight: 800;
  }

  .form-inputs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .input-field input,
  .input-field select {
    width: 100%;
    height: 52px;
    padding: 0 18px;
    background-color: #f6f8f5;
    border: 1px solid #e1e8df;
    border-radius: var(--radius-md);
    font-size: 14px;
    color: var(--color-text);
    outline: none;
    transition: all 0.2s ease;
  }

  .input-field input:focus,
  .input-field select:focus {
    background-color: #ffffff;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(90, 164, 40, 0.15);
  }

  .message-field {
    grid-column: span 2;
  }

  .submit-field {
    grid-column: span 1;
  }

  .quote-submit-btn {
    width: 100%;
    height: 52px;
    padding: 0 20px;
    font-size: 15px;
    border-radius: var(--radius-md);
  }

  .quote-form-status {
    margin-top: 12px;
    font-size: 14px;
    text-align: center;
    display: none;
    padding: 10px;
    border-radius: var(--radius-sm);
  }

  .quote-form-status.success {
    display: block;
    background-color: #eaf7e6;
    color: #216113;
    border: 1px solid #c7e8bd;
  }

  /* ===================== UNIVERSAL SECTION STYLES ===================== */
  .section {
    padding: 85px 0;
  }

  .section-title {
    font-size: clamp(28px, 3.8vw, 42px);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-primary);
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .text-center {
    text-align: center;
  }

  /* ===================== ABOUT SECTION ===================== */
  .about-section {
    background-color: var(--color-white);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .about-collage {
    position: relative;
    display: flex;
    gap: 20px;
  }

  .about-img-main {
    width: 58%;
    height: 480px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .about-img-main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-img-secondary {
    width: 42%;
    height: 380px;
    margin-top: 60px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .about-img-secondary img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-lead {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.6;
    color: var(--color-text);
    margin-bottom: 14px;
  }

  .about-body {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: 24px;
