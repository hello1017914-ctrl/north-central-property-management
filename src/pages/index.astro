<script>
  // Interactive client-side quote submission simulation
  const quoteForm = document.getElementById('home-quote-form') as HTMLFormElement;
  const quoteStatus = document.getElementById('quote-status');

  if (quoteForm && quoteStatus) {
    quoteForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(quoteForm);
      const name = formData.get('name');
      const phone = formData.get('phone');
      const service = formData.get('service');

      quoteStatus.className = 'quote-form-status success';
      quoteStatus.innerHTML = `<strong>Thank you, ${name}!</strong> Your request for <em>${service || 'property maintenance'}</em> has been received. Our team will contact you at <strong>${phone}</strong> within 24 hours.`;
      quoteForm.reset();
    });
  }
</script>