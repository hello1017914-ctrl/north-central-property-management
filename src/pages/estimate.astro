---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const estimateBg = "/images/hero.jpg";
---

<Layout 
  title="Request Free Estimate | Elite Property Maintenance LLC"
  description="Get a fast, free estimate for lawn care, snow plowing, car hauling, debris removal, or cleanups in Central Michigan. 20% Veteran & Senior Discount. Call 989-544-0791."
>
  <Header currentPage="estimate" />

  <main>
    <!-- PAGE HERO -->
    <section class="page-hero" style={`background-image: linear-gradient(rgba(15, 36, 14, 0.86), rgba(15, 36, 14, 0.92)), url('${estimateBg}')`}>
      <div class="container text-center">
        <div class="section-badge">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17 8C8 10 5 19 5 19C5 19 14 19 19 14C20.5 12.5 21 9 21 8C20 8 18 8 17 8Z"/></svg>
          <span>Free Estimate &bull; No Obligation</span>
        </div>
        <h1 class="page-hero-title">GET YOUR FREE PROPERTY ESTIMATE</h1>
        <p class="page-hero-subtitle">
          Transparent, upfront pricing tailored to your property. Fill out the form below or call 989-544-0791. Qualifying veterans and seniors receive 20% off.
        </p>
      </div>
    </section>

    <!-- ESTIMATE FORM & TRUST SECTION -->
    <section class="section estimate-main-section">
      <div class="container estimate-grid">
        <!-- Left: Comprehensive Form -->
        <div class="form-container-card">
          <div class="form-header">
            <h2 class="form-title">Tell Us About Your Property</h2>
            <p class="form-intro">We typically respond within 24 hours with an accurate, itemized quote.</p>
          </div>

          <form id="full-estimate-form" class="full-estimate-form">
            <!-- Contact Info -->
            <div class="form-section-title">1. Contact Information</div>
            <div class="form-row-2">
              <div class="form-group">
                <label for="est-name">Full Name *</label>
                <input type="text" id="est-name" name="name" required placeholder="John Doe" />
              </div>
              <div class="form-group">
                <label for="est-phone">Phone Number *</label>
                <input type="tel" id="est-phone" name="phone" required placeholder="989-544-0791" />
              </div>
            </div>

            <div class="form-row-2">
              <div class="form-group">
                <label for="est-email">Email Address *</label>
                <input type="email" id="est-email" name="email" required placeholder="john@example.com" />
              </div>
              <div class="form-group">
                <label for="est-address">Property Street Address &amp; City *</label>
                <input type="text" id="est-address" name="address" required placeholder="123 Oak St, Midland, MI" />
              </div>
            </div>

            <!-- Service Selection -->
            <div class="form-section-title">2. Select Needed Services</div>
            <div class="services-checkbox-grid">
              <label class="checkbox-box">
                <input type="checkbox" name="services" value="lawn-care" checked />
                <span class="box-text">
                  <strong>Lawn Care</strong>
                  <small>Mowing, Trimming, Edging</small>
                </span>
              </label>

              <label class="checkbox-box">
                <input type="checkbox" name="services" value="snow-plowing" />
                <span class="box-text">
                  <strong>Snow Plowing</strong>
                  <small>Driveways, Parking Lots, Sidewalks</small>
                </span>
              </label>

              <label class="checkbox-box">
                <input type="checkbox" name="services" value="debris-removal" />
                <span class="box-text">
                  <strong>Debris Removal</strong>
                  <small>Branches, Brush, Yard Waste</small>
                </span>
              </label>

              <label class="checkbox-box">
                <input type="checkbox" name="services" value="car-hauling" />
                <span class="box-text">
                  <strong>Car Hauling</strong>
                  <small>Junk Cars, Non-Running, Local &amp; Long Distance</small>
                </span>
              </label>

              <label class="checkbox-box">
                <input type="checkbox" name="services" value="seasonal-cleanup" />
                <span class="box-text">
                  <strong>Spring / Fall Cleanup</strong>
                  <small>Leaf Removal, Brush Cleanup, Property Cleanups</small>
                </span>
              </label>

              <label class="checkbox-box">
                <input type="checkbox" name="services" value="storm-damage" />
                <span class="box-text">
                  <strong>Storm Damage</strong>
                  <small>Tree Removal, Debris Cleanup, Emergency Services</small>
                </span>
              </label>
            </div>

            <!-- Property Details -->
            <div class="form-section-title">3. Property Specifications</div>
            <div class="form-row-2">
              <div class="form-group">
                <label for="est-property-type">Property Type</label>
                <select id="est-property-type" name="propertyType">
                  <option value="residential">Residential Home</option>
                  <option value="commercial">Commercial / Retail Property</option>
                  <option value="hoa">HOA / Multi-Family</option>
                  <option value="rural">Acreage / Rural Property</option>
                </select>
              </div>

              <div class="form-group">
                <label for="est-frequency">Service Frequency</label>
                <select id="est-frequency" name="frequency">
                  <option value="weekly">Weekly Maintenance</option>
                  <option value="biweekly">Bi-Weekly Maintenance</option>
                  <option value="seasonal">Full Season Contract</option>
                  <option value="onetime">One-Time Project</option>
                  <option value="emergency">Immediate Emergency Response</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="est-details">Additional Details / Special Instructions</label>
              <textarea id="est-details" name="details" rows="3" placeholder="Tell us about gate access, lot size, specific problem areas, or vehicle details..."></textarea>
            </div>

            <!-- Discount Checkbox -->
            <div class="discount-callout-box">
              <label class="discount-checkbox-label">
                <input type="checkbox" name="veteranDiscount" id="est-veteran-check" />
                <div>
                  <span class="discount-heading">🎖️ I am a Military Veteran or Senior Citizen (62+)</span>
                  <span class="discount-sub">Check this box to automatically apply our 20% discount on regular property maintenance!</span>
                </div>
              </label>
            </div>

            <button type="submit" class="btn-pill-green full-submit-btn">
              <span>SUBMIT ESTIMATE REQUEST</span>
              <span class="btn-arrow">&rarr;</span>
            </button>
          </form>

          <div id="full-estimate-success" class="estimate-success-state" style="display: none;">
            <div class="success-icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </div>
            <h3 class="success-title">Estimate Request Received!</h3>
            <p class="success-text">
              Thank you for contacting Elite Property Maintenance LLC. A team specialist will review your property specifications and call or email you within 24 hours with your free estimate.
            </p>
            <div class="success-actions">
              <a href="tel:989-544-0791" class="btn-pill-green">Need Immediate Help? Call 989-544-0791</a>
            </div>
          </div>
        </div>

        <!-- Right: What to Expect & Direct Call -->
        <div class="estimate-sidebar">
          <!-- Direct Phone Card -->
          <div class="sidebar-card phone-sidebar-card">
            <span class="side-kicker">Prefer To Talk Now?</span>
            <h3 class="side-phone-title">CALL FOR AN INSTANT ESTIMATE</h3>
            <p class="side-phone-desc">
              Have an urgent storm cleanup, car hauling need, or prefer speaking directly with our veteran team? Give us a call right now.
            </p>
            <a href="tel:989-544-0791" class="btn-pill-white side-call-btn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.64-3.97 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.97-8.64A2 2 0 018.1 5.24l3 3a2 2 0 01.21 2.97z"/></svg>
              <span>989-544-0791</span>
            </a>
          </div>

          <!-- The Process -->
          <div class="sidebar-card process-sidebar-card">
            <h4 class="side-card-title">What Happens Next?</h4>
            <div class="side-steps-list">
              <div class="side-step-item">
                <span class="step-num-badge">1</span>
                <div>
                  <strong>Quick Review</strong>
                  <p>We analyze your address and services to prepare a tailored quote.</p>
                </div>
              </div>
              <div class="side-step-item">
                <span class="step-num-badge">2</span>
                <div>
                  <strong>Transparent Proposal</strong>
                  <p>We present upfront, fixed pricing with zero hidden surcharges.</p>
                </div>
              </div>
              <div class="side-step-item">
                <span class="step-num-badge">3</span>
                <div>
                  <strong>Pristine Service</strong>
                  <p>Upon approval, we schedule our veteran crew to get the job done right.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Trust Badges List -->
          <div class="sidebar-card trust-sidebar-card">
            <h4 class="side-card-title">The Elite Guarantee</h4>
            <ul class="side-trust-list">
              <li>
                <span class="trust-icon">🎖️</span>
                <span>100% Veteran Owned &amp; Operated</span>
              </li>
              <li>
                <span class="trust-icon">🛡️</span>
                <span>Fully Licensed &amp; Insured in Michigan</span>
              </li>
              <li>
                <span class="trust-icon">⚡</span>
                <span>24-Hour Fast Quote Turnaround</span>
              </li>
              <li>
                <span class="trust-icon">⭐</span>
                <span>100% Satisfaction or We Make It Right</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .page-hero {
    background-size: cover;
    background-position: center;
    padding: 85px 0 95px;
    color: #ffffff;
    text-align: center;
  }

  .page-hero-title {
    font-family: var(--font-heading);
    font-size: clamp(30px, 4.5vw, 48px);
    font-weight: 900;
    line-height: 1.15;
    color: #ffffff;
    margin-bottom: 16px;
    text-transform: uppercase;
  }

  .page-hero-subtitle {
    font-size: 17px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    max-width: 720px;
    margin: 0 auto;
  }

  /* Estimate Grid */
  .estimate-main-section {
    background-color: var(--color-bg-light);
    padding: 60px 0 90px;
  }

  .estimate-grid {
    display: grid;
    grid-template-columns: 1.8fr 1.2fr;
    gap: 40px;
    align-items: flex-start;
  }

  /* Form Card */
  .form-container-card {
    background: var(--color-white);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-xl);
    padding: 40px;
    box-shadow: var(--shadow-md);
  }

  .form-header {
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--color-card-border);
  }

  .form-title {
    font-family: var(--font-heading);
    font-size: 26px;
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: 6px;
  }

  .form-intro {
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .form-section-title {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 800;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 24px 0 16px;
  }

  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 16px;
  }

  .form-group label {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-text);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 12px 16px;
    background-color: #f7faf6;
    border: 1px solid #dce8db;
    border-radius: var(--radius-sm);
    font-size: 14px;
    color: var(--color-text);
    outline: none;
    transition: all 0.2s ease;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    background-color: #ffffff;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(90, 164, 40, 0.15);
  }

  /* Services Checkbox Grid */
  .services-checkbox-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 20px;
  }

  .checkbox-box {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: #f7faf6;
    border: 1px solid #dce8db;
    border-radius: var(--radius-md);
    padding: 14px 16px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .checkbox-box:hover {
    border-color: var(--color-accent);
    background-color: #f0f8ed;
  }

  .checkbox-box input[type="checkbox"] {
    margin-top: 3px;
    accent-color: var(--color-accent);
    width: 16px;
    height: 16px;
  }

  .box-text strong {
    display: block;
    font-size: 14px;
    color: var(--color-primary);
  }

  .box-text small {
    display: block;
    font-size: 12px;
    color: var(--color-text-muted);
  }

  /* Discount Callout */
  .discount-callout-box {
    background-color: #fbf1f1;
    border: 1.5px dashed #f5baba;
    border-radius: var(--radius-md);
    padding: 16px 20px;
    margin: 24px 0;
  }

  .discount-checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    cursor: pointer;
  }

  .discount-checkbox-label input[type="checkbox"] {
    margin-top: 3px;
    accent-color: var(--color-veteran-red);
    width: 18px;
    height: 18px;
  }

  .discount-heading {
    display: block;
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 800;
    color: var(--color-veteran-red);
    margin-bottom: 2px;
  }

  .discount-sub {
    display: block;
    font-size: 13px;
    color: #684141;
  }

  .full-submit-btn {
    width: 100%;
    padding: 18px;
    font-size: 16px;
  }

  /* Success State */
  .estimate-success-state {
    text-align: center;
    padding: 40px 20px;
  }

  .success-icon-wrap {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background-color: var(--color-badge-bg);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
  }

  .success-icon-wrap svg {
    width: 36px;
    height: 36px;
  }

  .success-title {
    font-family: var(--font-heading);
    font-size: 28px;
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: 12px;
  }

  .success-text {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 500px;
    margin: 0 auto 28px;
  }

  /* Sidebar Cards */
  .estimate-sidebar {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .sidebar-card {
    background: var(--color-white);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-xl);
    padding: 30px;
    box-shadow: var(--shadow-sm);
  }

  .phone-sidebar-card {
    background: linear-gradient(135deg, #173715 0%, #0f240e 100%);
    color: #ffffff;
    border: none;
  }

  .side-kicker {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-light);
    display: block;
    margin-bottom: 6px;
  }

  .side-phone-title {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 10px;
  }

  .side-phone-desc {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .side-call-btn {
    width: 100%;
    justify-content: center;
  }

  .side-card-title {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--color-badge-bg);
  }

  .side-steps-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .side-step-item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .step-num-badge {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: var(--color-accent);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 13px;
    flex-shrink: 0;
  }

  .side-step-item strong {
    display: block;
    font-size: 14px;
    color: var(--color-primary);
    margin-bottom: 2px;
  }

  .side-step-item p {
    font-size: 13px;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .side-trust-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .side-trust-list li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text);
  }

  .trust-icon {
    font-size: 18px;
  }

  @media (max-width: 1024px) {
    .estimate-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .form-container-card {
      padding: 24px 18px;
    }

    .form-row-2,
    .services-checkbox-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('full-estimate-form') as HTMLFormElement;
  const successState = document.getElementById('full-estimate-success');

  if (form && successState) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      form.style.display = 'none';
      successState.style.display = 'block';
      window.scrollTo({
        top: successState.getBoundingClientRect().top + window.scrollY - 100,
        behavior: 'smooth'
      });
    });
  }
</script>
