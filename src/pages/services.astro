---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const serviceImages = {
  hero: "/images/hero.jpg",
  lawnCare: "/images/service-lawn-care.jpg",
  cleanup: "/images/service-cleanup.jpg",
  gutterCleaning: "/images/gutter-cleaning.jpg",
  animalDamage: "/images/animal-damage-control.jpg"
};
---

<Layout 
  title="Our Services | North Central Property Management - (989) 259-8499"
  description="Explore our core services: lawn care, spring and fall cleanups, gutter cleaning, and animal damage control in Central Michigan. Call (989) 259-8499."
>
  <Header currentPage="services" />

  <main>
    <!-- PAGE HERO -->
    <section class="page-hero" style={`background-image: linear-gradient(rgba(15, 36, 14, 0.86), rgba(15, 36, 14, 0.92)), url('${serviceImages.hero}')`}>
      <div class="container text-center">
        <div class="section-badge">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17 8C8 10 5 19 5 19C5 19 14 19 19 14C20.5 12.5 21 9 21 8C20 8 18 8 17 8Z"/></svg>
          <span>North Central Property Management</span>
        </div>
        <h1 class="page-hero-title">EXPERT LAWN &amp; PROPERTY SERVICES</h1>
        <p class="page-hero-subtitle">
          Quality work you can count on! Precision mowing, thorough seasonal cleanups, professional gutter clearing, and humane wildlife exclusion &amp; damage repairs.
        </p>
      </div>
    </section>

    <!-- SERVICES NAVIGATION PILLS -->
    <section class="service-nav-bar">
      <div class="container">
        <div class="nav-pills-row">
          <a href="#lawn-care" class="pill-nav-item">Lawn Care</a>
          <a href="#cleanup" class="pill-nav-item">Spring / Fall Clean Up</a>
          <a href="#gutter-cleaning" class="pill-nav-item">Gutter Cleaning</a>
          <a href="#animal-damage-control" class="pill-nav-item">Animal Damage Control</a>
        </div>
      </div>
    </section>

    <!-- DETAILED SERVICE BLOCKS -->
    <section class="section service-details-section">
      <div class="container service-blocks-wrap">
        
        <!-- 1. LAWN CARE -->
        <article class="service-block" id="lawn-care">
          <div class="service-block-media">
            <img src={serviceImages.lawnCare} alt="Lawn care service" loading="lazy" />
            <span class="media-badge">Most Popular</span>
          </div>
          <div class="service-block-body">
            <div class="section-badge">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17 8C8 10 5 19 5 19C5 19 14 19 19 14C20.5 12.5 21 9 21 8C20 8 18 8 17 8Z"/></svg>
              <span>Service 01</span>
            </div>
            <h2 class="service-block-title">LAWN CARE, MOWING &amp; EDGING</h2>
            <p class="service-block-lead">
              A lush, healthy, evenly cut lawn creates an unforgettable first impression. We deliver precision mowing, weed whacking, and razor-sharp perimeter edging.
            </p>
            <ul class="service-check-list">
              <li><strong>Precision Striping &amp; Mowing:</strong> Sharp blades cut at the ideal seasonal height for root strength and drought defense.</li>
              <li><strong>Clean Edge Trimming:</strong> Flush trimming along curbs, walkways, garden beds, trees, and fence perimeters.</li>
              <li><strong>Walkway Debris Blowing:</strong> High-powered leaf blowers clear all patios, driveways, and sidewalks before we leave.</li>
              <li><strong>Flexible Schedules:</strong> Weekly, bi-weekly, or seasonal scheduled routes tailored to your grass growth rate.</li>
            </ul>
            <div class="service-block-actions">
              <a href="/estimate" class="btn-pill-green">Request Free Lawn Quote &rarr;</a>
              <a href="tel:989-259-8499" class="btn-pill-white">Call (989) 259-8499</a>
            </div>
          </div>
        </article>

        <!-- 2. SPRING / FALL CLEAN UP -->
        <article class="service-block reverse" id="cleanup">
          <div class="service-block-media">
            <img src={serviceImages.cleanup} alt="Fall leaf cleanup and property raking" loading="lazy" />
            <span class="media-badge">Seasonal Essential</span>
          </div>
          <div class="service-block-body">
            <div class="section-badge">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17 8C8 10 5 19 5 19C5 19 14 19 19 14C20.5 12.5 21 9 21 8C20 8 18 8 17 8Z"/></svg>
              <span>Service 02</span>
            </div>
            <h2 class="service-block-title">SPRING &amp; FALL CLEAN UP</h2>
            <p class="service-block-lead">
              Preparing your landscape for changing seasons is vital for long-term turf health and preventing mold or pests from nesting under dead foliage.
            </p>
            <ul class="service-check-list">
              <li><strong>Spring Thaw Cleanups:</strong> Raking winter dead grass, sticks, and gravel spread during winter plowing.</li>
              <li><strong>Fall Leaf Raking &amp; Haul-Away:</strong> Deep leaf clearing from turf, landscape beds, window wells, and patios.</li>
              <li><strong>Garden Bed Refresh:</strong> Perennial cutbacks, edging freshening, and winter preparation.</li>
              <li><strong>Yard Waste Removal:</strong> We load and haul away all bags and piles so your yard is left spotless.</li>
            </ul>
            <div class="service-block-actions">
              <a href="/estimate" class="btn-pill-green">Book Seasonal Cleanup &rarr;</a>
              <a href="tel:989-259-8499" class="btn-pill-white">Call (989) 259-8499</a>
            </div>
          </div>
        </article>

        <!-- 3. GUTTER CLEANING -->
        <article class="service-block" id="gutter-cleaning">
          <div class="service-block-media">
            <img src={serviceImages.gutterCleaning} alt="Professional gutter cleaning technician" loading="lazy" />
            <span class="media-badge">Protection Priority</span>
          </div>
          <div class="service-block-body">
            <div class="section-badge">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17 8C8 10 5 19 5 19C5 19 14 19 19 14C20.5 12.5 21 9 21 8C20 8 18 8 17 8Z"/></svg>
              <span>Service 03</span>
            </div>
            <h2 class="service-block-title">PROFESSIONAL GUTTER CLEANING</h2>
            <p class="service-block-lead">
              Clogged gutters cause water overflow, roof edge rotting, ice damming in winter, and foundation water damage. We keep your drainage system completely clear.
            </p>
            <ul class="service-check-list">
              <li><strong>Hand &amp; Tool Debris Extraction:</strong> Removal of wet leaves, pine needles, twigs, and sludge buildup.</li>
              <li><strong>Downspout Snaking &amp; Flushing:</strong> Ensuring water flows unrestricted from eaves to ground level outlets.</li>
              <li><strong>Fascia &amp; Gutter Inspection:</strong> Checking for sagging brackets, loose spikes, and joint leaks.</li>
              <li><strong>Ground-Level Clean Sweep:</strong> Any debris cleared from the roof is caught or raked clean before departure.</li>
            </ul>
            <div class="service-block-actions">
              <a href="/estimate" class="btn-pill-green">Schedule Gutter Cleaning &rarr;</a>
              <a href="tel:989-259-8499" class="btn-pill-white">Call (989) 259-8499</a>
            </div>
          </div>
        </article>

        <!-- 4. ANIMAL DAMAGE CONTROL -->
        <article class="service-block reverse" id="animal-damage-control">
          <div class="service-block-media">
            <img src={serviceImages.animalDamage} alt="Animal damage repair and humane wildlife exclusion" loading="lazy" />
            <span class="media-badge">Specialized Defense</span>
          </div>
          <div class="service-block-body">
            <div class="section-badge">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17 8C8 10 5 19 5 19C5 19 14 19 19 14C20.5 12.5 21 9 21 8C20 8 18 8 17 8Z"/></svg>
              <span>Service 04</span>
            </div>
            <h2 class="service-block-title">ANIMAL DAMAGE CONTROL &amp; REPAIR</h2>
            <p class="service-block-lead">
              Wild animals such as raccoons, squirrels, bats, and birds can cause extensive structural destruction to soffits, fascia, attic vents, and crawlspaces. We repair and secure your property.
            </p>
            <ul class="service-check-list">
              <li><strong>Entry Point Inspection:</strong> Locating gnawed eaves, displaced vent covers, and damaged fascia boards.</li>
              <li><strong>Humane Exclusion Solutions:</strong> Ensuring wildlife exits safely without becoming trapped inside structures.</li>
              <li><strong>Structural Wood &amp; Metal Repairs:</strong> Patching, replacing damaged boards, and installing heavy-gauge wire exclusion screening.</li>
              <li><strong>Long-Term Prevention:</strong> Reinforcing vulnerable exterior perimeters to stop future animal infiltration.</li>
            </ul>
            <div class="service-block-actions">
              <a href="/estimate" class="btn-pill-green">Get Damage Control Estimate &rarr;</a>
              <a href="tel:989-259-8499" class="btn-pill-white">Call (989) 259-8499</a>
            </div>
          </div>
        </article>

      </div>
    </section>

    <!-- PROMO BANNER -->
    <section class="veteran-promo-section">
      <div class="container text-center">
        <div class="section-badge">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z"/></svg>
          <span>North Central Property Management</span>
        </div>
        <h2 class="promo-title">QUALITY WORK YOU CAN COUNT ON</h2>
        <p class="promo-desc">
          Contact us today to schedule your lawn care, seasonal cleanups, gutter cleaning, or wildlife damage repair. Fast, dependable service across Central Michigan.
        </p>
        <div class="promo-actions">
          <a href="/estimate" class="btn-pill-green">Request Your Free Estimate &rarr;</a>
          <a href="tel:989-259-8499" class="btn-pill-white">Call (989) 259-8499</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .page-hero {
    background-size: cover;
    background-position: center;
    padding: 85px 0 95px;
    color: #ffffff;
    text-align: center;
  }

  .page-hero-title {
    font-family: var(--font-heading);
    font-size: clamp(30px, 4.5vw, 48px);
    font-weight: 900;
    line-height: 1.15;
    color: #ffffff;
    margin-bottom: 16px;
    text-transform: uppercase;
  }

  .page-hero-subtitle {
    font-size: 17px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    max-width: 720px;
    margin: 0 auto;
  }

  /* Navigation Bar */
  .service-nav-bar {
    background: #ffffff;
    border-bottom: 1px solid var(--color-card-border);
    padding: 20px 0;
    position: relative;
  }

  .nav-pills-row {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .pill-nav-item {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    color: var(--color-primary);
    background: var(--color-bg-light);
    border: 1px solid var(--color-card-border);
    padding: 8px 18px;
    border-radius: var(--radius-full);
    transition: all 0.2s ease;
  }

  .pill-nav-item:hover {
    background: var(--color-accent);
    color: #ffffff;
    border-color: var(--color-accent);
  }

  /* Service Blocks Wrap */
  .service-details-section {
    background-color: var(--color-bg-light);
  }

  .service-blocks-wrap {
    display: flex;
    flex-direction: column;
    gap: 70px;
  }

  .service-block {
    scroll-margin-top: 100px;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 50px;
    align-items: center;
    background: var(--color-white);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-xl);
    padding: 40px;
    box-shadow: var(--shadow-sm);
    transition: all 0.3s ease;
  }

  .service-block:hover {
    box-shadow: var(--shadow-lg);
    border-color: #bcdbb4;
  }

  .service-block.reverse {
    grid-template-columns: 1.2fr 1fr;
  }

  .service-block.reverse .service-block-media {
    order: 2;
  }

  .service-block.reverse .service-block-body {
    order: 1;
  }

  .service-block-media {
    position: relative;
    height: 380px;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .service-block-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .service-block:hover .service-block-media img {
    transform: scale(1.05);
  }

  .media-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    background: rgba(16, 36, 14, 0.85);
    backdrop-filter: blur(4px);
    color: var(--color-accent-light);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 6px 14px;
    border-radius: var(--radius-full);
  }

  .service-block-title {
    font-family: var(--font-heading);
    font-size: clamp(24px, 3.2vw, 32px);
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: 14px;
    line-height: 1.2;
  }

  .service-block-lead {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text);
    margin-bottom: 20px;
    font-weight: 500;
  }

  .service-check-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 30px;
  }

  .service-check-list li {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text-muted);
    position: relative;
    padding-left: 24px;
  }

  .service-check-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-accent);
    font-weight: 800;
  }

  .service-check-list strong {
    color: var(--color-primary);
  }

  .service-block-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  /* Promo Banner */
  .veteran-promo-section {
    background: linear-gradient(135deg, #173715 0%, #0d210c 100%);
    color: #ffffff;
    padding: 70px 0;
  }

  .promo-title {
    font-family: var(--font-heading);
    font-size: clamp(26px, 3.8vw, 38px);
    font-weight: 900;
    color: #ffffff;
    margin-bottom: 14px;
  }

  .promo-desc {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.85);
    max-width: 600px;
    margin: 0 auto 28px;
  }

  .promo-actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  @media (max-width: 1024px) {
    .service-block,
    .service-block.reverse {
      grid-template-columns: 1fr;
    }

    .service-block.reverse .service-block-media {
      order: 1;
    }

    .service-block.reverse .service-block-body {
      order: 2;
    }
  }

  @media (max-width: 640px) {
    .service-block {
      padding: 24px 18px;
    }

    .service-block-media {
      height: 240px;
    }
  }
</style>