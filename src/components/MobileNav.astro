}

.mobile-nav-link.active {
  background-color: var(--color-primary-60);
  color: var(--color-neutral);
}

.mobile-contact-actions {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding-top: 16px;
  border-top: 1px solid var(--color-border);
}

.mobile-call-btn, .mobile-estimate-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 16px 24px;
  border-radius: var(--rounded-md);
  text-decoration: none;
  font-family: var(--font-label-md);
  font-size: 16px;
  font-weight: 600;
  transition: all 0.2s ease;
}

.mobile-call-btn {
  background-color: var(--color-primary);
  color: var(--color-neutral);
}

.mobile-call-btn:hover {
  background-color: var(--color-primary-60);
}

.mobile-estimate-btn {
  background-color: var(--color-tertiary);
  color: var(--color-primary);
  border: 1px solid var(--color-primary);
}

.mobile-estimate-btn:hover {
  background-color: var(--color-primary-60);
  color: var(--color-neutral);
}

.mobile-btn-icon {
  width: 20px;
  height: 20px;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

// Toggle styles
.mobile-menu-toggle.active span:first-child {
  transform: rotate(45deg) translate(5px, 6px);
}

.mobile-menu-toggle.active span:nth-child(2) {
  opacity: 0;
}

.mobile-menu-toggle.active span:last-child {
  transform: rotate(-45deg) translate(5px, -6px);
}

@media (max-width: 768px) {
  .mobile-menu-toggle {
    display: flex;
  }

  .mobile-navigation {
    width: 100%;
  }

  .mobile-menu {
    width: 100%;
    left: 0;
    right: 0;
  }
}
</style>

<script>
// Mobile navigation functionality
const mobileMenuToggle = document.querySelector('.mobile-menu-toggle');
const mobileMenu = document.querySelector('.mobile-menu');
let isMenuOpen = false;

mobileMenuToggle?.addEventListener('click', () => {
  isMenuOpen = !isMenuOpen;

  mobileMenuToggle.setAttribute('aria-expanded', isMenuOpen.toString());
  mobileMenuToggle.classList.toggle('active', isMenuOpen);
  mobileMenu.classList.toggle('active', isMenuOpen);
  mobileMenu.setAttribute('aria-hidden', (!isMenuOpen).toString());
});

// Close mobile menu when clicking a link
const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
mobileNavLinks.forEach(link => {
  link.addEventListener('click', () => {
    if (isMenuOpen) {
      isMenuOpen = false;
      mobileMenuToggle.setAttribute('aria-expanded', 'false');
      mobileMenuToggle.classList.remove('active');
      mobileMenu.classList.remove('active');
      mobileMenu.setAttribute('aria-hidden', 'true');
    }
  });
});

// Set active nav link based on current page
const currentPath = window.location.pathname;
const navLinks = document.querySelectorAll('.mobile-nav-link');
navLinks.forEach(link => {
  const linkPath = link.getAttribute('data-path');
  if (linkPath === currentPath) {
    link.classList.add('active');
  }
});
</script>