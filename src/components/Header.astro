---
interface Props {
  currentPage?: string;
}

const { currentPage = "" } = Astro.props;
---

<header class="site-header" id="site-header">


  <!-- Main Navbar -->
  <nav class="main-nav">
    <div class="container nav-inner">
      <!-- Logo: Stylized Emblem Matching Concept Mockup -->
      <a href="/" class="brand-logo" aria-label="North Central Property Management">
        <div class="logo-emblem">
          <svg viewBox="0 0 48 48" class="logo-svg" fill="none">
            <!-- Outer green circular badge -->
            <circle cx="24" cy="24" r="22" fill="#173715" />
            <!-- Inner leaf arc -->
            <path d="M10 24C10 31.7 16.3 38 24 38C31.7 38 38 31.7 38 24" stroke="#5aa428" stroke-width="2.5" stroke-linecap="round" />
            <!-- Pine tree silhouette matching North Central logo -->
            <path d="M24 8L18 19H22L16 26H21L15 34H33L27 26H32L26 19H30L24 8Z" fill="#5aa428" />
            <rect x="22.5" y="34" width="3" height="5" fill="#8cb952" />
          </svg>
        </div>
        <div class="logo-text-group">
          <span class="logo-brand-name">NORTH CENTRAL</span>
          <span class="logo-brand-subtitle">PROPERTY MANAGEMENT</span>
        </div>
      </a>

      <!-- Desktop Links -->
      <ul class="nav-links">
        <li>
          <a href="/" class:list={["nav-item", { active: currentPage === "home" }]}>
            <span>Home</span>
          </a>
        </li>
        <li>
          <a href="/about" class:list={["nav-item", { active: currentPage === "about" }]}>
            <span>About</span>
          </a>
        </li>
        <li class="has-dropdown">
          <a href="/services" class:list={["nav-item", { active: currentPage === "services" }]}>
            <span>Services</span>
            <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M6 9l6 6 6-6" />
            </svg>
          </a>
          <ul class="nav-dropdown">
            <li><a href="/services#lawn-care">Lawn Care</a></li>
            <li><a href="/services#cleanup">Spring / Fall Clean Up</a></li>
            <li><a href="/services#gutter-cleaning">Gutter Cleaning</a></li>
            <li><a href="/services#animal-damage-control">Animal Damage Control</a></li>
          </ul>
        </li>
        <li>
          <a href="/projects" class:list={["nav-item", { active: currentPage === "projects" }]}>
            <span>Projects</span>
          </a>
        </li>
        <li>
          <a href="/estimate" class:list={["nav-item", { active: currentPage === "estimate" }]}>
            <span>Free Estimate</span>
          </a>
        </li>
        <li>
          <a href="/contact" class:list={["nav-item", { active: currentPage === "contact" }]}>
            <span>Contact</span>
          </a>
        </li>
      </ul>

      <!-- Call Now Box: Clean Open Style Matching Concept Mockup -->
      <div class="header-cta-wrap">
        <a href="tel:989-259-8499" class="clean-call-widget">
          <div class="call-circle-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.64-3.97 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.97-8.64A2 2 0 018.1 5.24l3 3a2 2 0 01.21 2.97z"/>
            </svg>
          </div>
          <div class="call-info">
            <span class="call-caption">Call Now</span>
            <strong class="call-digits">(989) 259-8499</strong>
          </div>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button class="mobile-toggle" id="mobile-toggle-btn" aria-label="Toggle navigation menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile Drawer Menu -->
  <div class="mobile-drawer" id="mobile-drawer">
    <div class="mobile-drawer-content">
      <ul class="mobile-links">
        <li><a href="/" class="mobile-item">Home</a></li>
        <li><a href="/about" class="mobile-item">About Us</a></li>
        <li><a href="/services" class="mobile-item">Our Services</a></li>
        <li><a href="/projects" class="mobile-item">Project Gallery</a></li>
        <li><a href="/estimate" class="mobile-item">Request Free Estimate</a></li>
        <li><a href="/contact" class="mobile-item">Contact Us</a></li>
      </ul>

      <div class="mobile-drawer-footer">
        <a href="tel:989-259-8499" class="btn-pill-green mobile-call-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.64-3.97 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.97-8.64A2 2 0 018.1 5.24l3 3a2 2 0 01.21 2.97z"/>
          </svg>
          Call (989) 259-8499
        </a>
        <a href="/estimate" class="btn-pill-white mobile-quote-btn">
          Request Free Quote &rarr;
        </a>
        <p class="mobile-discount-note">Professional Property Management &bull; Free Estimates</p>
      </div>
    </div>
  </div>
</header>

<!-- Spacer to prevent content jump when header is fixed -->
<div class="header-spacer"></div>

<style>
  /* ===================== FIXED SMART HEADER ===================== */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 1000;
    background: var(--color-white);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease, box-shadow 0.3s ease;
    will-change: transform, opacity;
  }

  /* Scrolled Shadow */
  .site-header.header-scrolled {
    box-shadow: 0 10px 30px rgba(15, 36, 14, 0.08);
  }

  /* Hidden on Scroll Down */
  .site-header.header-hidden {
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
  }

  /* Header Spacer */
  .header-spacer {
    height: 80px;
  }

  /* ===================== MAIN NAVBAR ===================== */
  .main-nav {
    background: var(--color-white);
    padding: 16px 0;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  /* Logo */
  .brand-logo {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
  }

  .logo-emblem {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .brand-logo:hover .logo-emblem {
    transform: rotate(4deg) scale(1.05);
  }

  .logo-svg {
    width: 100%;
    height: 100%;
  }

  .logo-text-group {
    display: flex;
    flex-direction: column;
  }

  .logo-brand-name {
    font-family: var(--font-heading);
    font-size: 23px;
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--color-primary);
    line-height: 1.1;
  }

  .logo-brand-subtitle {
    font-size: 11px;
    font-weight: 800;
    color: var(--color-accent);
    letter-spacing: 0.08em;
  }

  /* Nav Links Matching Concept */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
    list-style: none;
  }

  .nav-item {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 700;
    color: #1a2618;
    position: relative;
    padding: 8px 0;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color 0.2s ease;
  }

  .chevron-icon {
    width: 13px;
    height: 13px;
    transition: transform 0.2s ease;
  }

  .has-dropdown:hover .chevron-icon {
    transform: rotate(180deg);
  }

  /* Active highlight bar under link */
  .nav-item::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0%;
    height: 2.5px;
    background-color: var(--color-accent);
    border-radius: var(--radius-full);
    transition: width 0.25s ease;
  }

  .nav-item:hover,
  .nav-item.active {
    color: var(--color-accent);
  }

  .nav-item:hover::after,
  .nav-item.active::after {
    width: 100%;
  }

  /* Dropdown Menu */
  .has-dropdown {
    position: relative;
  }

  .nav-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    background: #ffffff;
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-md);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
    min-width: 220px;
    list-style: none;
    padding: 8px 0;
    display: none;
    z-index: 100;
  }

  .has-dropdown:hover .nav-dropdown {
    display: block;
    animation: fadeIn 0.2s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .nav-dropdown li a {
    display: block;
    padding: 10px 18px;
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    color: var(--color-text);
  }

  .nav-dropdown li a:hover {
    background-color: #f0f7ed;
    color: var(--color-accent);
  }

  /* ===================== CLEAN CALL WIDGET (Matching Concept) ===================== */
  .header-cta-wrap {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .clean-call-widget {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    padding: 4px 6px;
    transition: all 0.2s ease;
  }

  .call-circle-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: var(--color-accent);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 14px var(--color-accent-glow);
    transition: transform 0.25s ease, background-color 0.2s ease;
  }

  .call-circle-btn svg {
    width: 20px;
    height: 20px;
  }

  .clean-call-widget:hover .call-circle-btn {
    transform: scale(1.08);
    background-color: var(--color-accent-hover);
  }

  .call-info {
    display: flex;
    flex-direction: column;
  }

  .call-caption {
    font-size: 12px;
    font-weight: 600;
    color: #6a7c67;
    line-height: 1;
    margin-bottom: 3px;
  }

  .call-digits {
    font-family: var(--font-heading);
    font-size: 19px;
    font-weight: 900;
    color: var(--color-primary);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .clean-call-widget:hover .call-digits {
    color: var(--color-accent);
  }

  /* ===================== MOBILE DRAWER & TOGGLE ===================== */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: var(--color-bg-light);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-sm);
    padding: 8px;
    cursor: pointer;
  }

  .mobile-toggle span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--color-primary);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .mobile-drawer {
    display: none;
    background: var(--color-white);
    border-top: 1px solid var(--color-card-border);
    padding: 24px;
    box-shadow: 0 16px 30px rgba(0, 0, 0, 0.1);
  }

  .mobile-drawer.open {
    display: block;
    animation: slideDown 0.25s ease-out;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mobile-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 24px;
  }

  .mobile-item {
    display: block;
    font-family: var(--font-heading);
    font-size: 17px;
    font-weight: 700;
    color: var(--color-text);
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    background: var(--color-bg-light);
  }

  .mobile-item:hover {
    color: var(--color-accent);
    background: #edf7e9;
  }

  .mobile-drawer-footer {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .mobile-call-btn,
  .mobile-quote-btn {
    width: 100%;
    text-align: center;
    padding: 14px;
  }

  .mobile-discount-note {
    font-size: 12px;
    color: var(--color-text-muted);
    text-align: center;
    margin-top: 6px;
    font-weight: 600;
  }

  /* Responsive Rules */
  @media (max-width: 1024px) {
    .nav-links {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
  }

  @media (max-width: 768px) {
    .header-spacer {
      height: 76px;
    }
    .call-info {
      display: none;
    }
    .clean-call-widget {
      padding: 0;
    }
  }
</style>

<script>
  // Mobile Menu Toggle
  const toggleBtn = document.getElementById('mobile-toggle-btn');
  const drawer = document.getElementById('mobile-drawer');

  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      drawer.classList.toggle('open');
      const spans = toggleBtn.querySelectorAll('span');
      if (drawer.classList.contains('open')) {
        spans[0].style.transform = 'rotate(45deg) translate(5px, 5px)';
        spans[1].style.opacity = '0';
        spans[2].style.transform = 'rotate(-45deg) translate(5px, -5px)';
      } else {
        spans[0].style.transform = 'none';
        spans[1].style.opacity = '1';
        spans[2].style.transform = 'none';
      }
    });
  }

  // Smooth Scroll Hide / Reveal Behavior
  const header = document.getElementById('site-header');
  let lastScrollY = window.scrollY;
  let isHidden = false;

  window.addEventListener('scroll', () => {
    const currentScrollY = window.scrollY;

    // When near the top / hero section (top 90px): always show fully and remove scroll shadow
    if (currentScrollY <= 90) {
      header?.classList.remove('header-hidden');
      header?.classList.remove('header-scrolled');
      isHidden = false;
      lastScrollY = currentScrollY;
      return;
    }

    // Add sleek shadow when scrolled
    header?.classList.add('header-scrolled');

    // Scrolling DOWN -> Submerge / fade up and disappear
    if (currentScrollY > lastScrollY && currentScrollY > 140) {
      if (!isHidden) {
        header?.classList.add('header-hidden');
        // Also close mobile drawer if open
        if (drawer?.classList.contains('open')) {
          drawer.classList.remove('open');
        }
        isHidden = true;
      }
    } 
    // Scrolling UP -> Reveal smoothly and show up
    else if (currentScrollY < lastScrollY) {
      if (isHidden) {
        header?.classList.remove('header-hidden');
        isHidden = false;
      }
    }

    lastScrollY = currentScrollY;
  }, { passive: true });
</script>