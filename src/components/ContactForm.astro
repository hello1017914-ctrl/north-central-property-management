<form class="contact-form" onsubmit="handleSubmit(event)">
  <div class="form-group">
    <label for="name">Full Name</label>
    <input type="text" id="name" name="name" required placeholder="John Doe" />
  </div>

  <div class="form-group">
    <label for="phone">Phone Number</label>
    <input type="tel" id="phone" name="phone" required placeholder="989-544-0791" pattern="\d{3}-\d{3}-\d{4}" />
  </div>

  <div class="form-group">
    <label for="email">Email (Optional)</label>
    <input type="email" id="email" name="email" placeholder="john@example.com" />
  </div>

  <div class="form-group">
    <label for="service">Service Needed</label>
    <select id="service" name="service" required>
      <option value="">Select a service</option>
      <option value="lawn-care">Lawn Care</option>
      <option value="snow-plowing">Snow Plowing</option>
      <option value="debris-removal">Debris Removal</option>
      <option value="car-hauling">Car Hauling</option>
      <option value="cleanup">Seasonal Cleanup</option>
      <option value="storm-damage">Storm Damage</option>
      <option value="other">Other</option>
    </select>
  </div>

  <div class="form-group">
    <label for="location">Property Location</label>
    <input type="text" id="location" name="location" required placeholder="123 Main St, Anytown, MI" />
  </div>

  <div class="form-group">
    <label for="details">Project Details</label>
    <textarea id="details" name="details" rows="4" placeholder="Describe your property maintenance needs..."></textarea>
  </div>

  <div class="form-group">
    <label class="checkbox-label">
      <input type="checkbox" id="veteran" name="veteran" />
      <span class="checkbox-text">I am a veteran or senior and qualify for a discount</span>
    </label>
  </div>

  <button type="submit" class="submit-button">
    <span>Request My Free Estimate</span>
    <svg class="button-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 19l9 2-9-19-9 19 9-2zm0 0v-8"/>
    </svg>
  </button>

  <div class="form-note">
    <p>We'll contact you within 24 hours to schedule your free estimate.</p>
  </div>
</form>

<div class="alternative-contact">
  <p>Prefer to call us directly?</p>
  <a href="tel:989-544-0791" class="phone-alt">989-544-0791</a>
</div>

<style>
.contact-form {
  max-width: 600px;
  margin: 0 auto;
  padding: 32px;
  background-color: var(--color-neutral);
  border-radius: var(--rounded-lg);
  border: 1px solid var(--color-border);
}

.form-group {
  margin-bottom: 24px;
}

label {
  display: block;
  margin-bottom: 8px;
  font-family: var(--font-label-md);
  font-size: 14px;
  font-weight: 600;
  color: var(--color-primary);
}

input, select, textarea {
  width: 100%;
  padding: 12px 16px;
  border: 1px solid var(--color-border);
  border-radius: var(--rounded-md);
  font-family: var(--font-body-md);
  font-size: 16px;
  color: var(--color-primary);
  background-color: var(--color-neutral);
  transition: all 0.2s ease;
}

input:focus, select:focus, textarea:focus {
  outline: none;
  border-color: var(--color-primary);
  box-shadow: 0 0 0 3px rgba(45, 80, 22, 0.1);
}

textarea {
  resize: vertical;
  min-height: 100px;
}

.checkbox-label {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  cursor: pointer;
  font-family: var(--font-body-sm);
  color: var(--color-primary-60);
}

.checkbox-label input[type="checkbox"] {
  width: 20px;
  height: 20px;
  margin-top: 2px;
  accent-color: var(--color-primary);
}

.submit-button {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 16px 32px;
  background-color: var(--color-primary);
  color: var(--color-neutral);
  border: none;
  border-radius: var(--rounded-md);
  font-family: var(--font-label-lg);
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  margin-top: 24px;
}

.submit-button:hover {
  background-color: var(--color-primary-60);
  transform: translateY(-2px);
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
}

.button-icon {
  width: 20px;
  height: 20px;
}

.form-note {
  margin-top: 24px;
  padding-top: 24px;
  border-top: 1px solid var(--color-border);
  text-align: center;
}

.form-note p {
  font-family: var(--font-body-sm);
  color: var(--color-primary-60);
  margin: 0;
}

.alternative-contact {
  margin-top: 32px;
  padding-top: 32px;
  border-top: 1px solid var(--color-border);
  text-align: center;
}

.alternative-contact p {
  font-family: var(--font-body-sm);
  color: var(--color-primary-60);
  margin-bottom: 16px;
}

.phone-alt {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--color-primary);
  text-decoration: none;
  font-family: var(--font-label-lg);
  font-size: 20px;
  font-weight: 600;
  padding: 12px 24px;
  background-color: var(--color-tertiary);
  border-radius: var(--rounded-md);
  transition: all 0.2s ease;
}

.phone-alt:hover {
  background-color: var(--color-primary-60);
  color: var(--color-neutral);
}

@media (max-width: 768px) {
  .contact-form {
    padding: 24px;
  }

  input, select, textarea {
    font-size: 16px;
  }

  .submit-button {
    padding: 14px 28px;
    font-size: 15px;
  }

  .phone-alt {
    font-size: 18px;
    padding: 10px 20px;
  }
}
</style>

<script>
function handleSubmit(event) {
  event.preventDefault();

  const form = event.target;
  const formData = new FormData(form);

  // Simple validation
  const name = formData.get('name');
  const phone = formData.get('phone');
  const service = formData.get('service');
  const location = formData.get('location');

  if (!name || !phone || !service || !location) {
    alert('Please fill in all required fields.');
    return;
  }

  // Phone number validation (simple pattern)
  const phonePattern = /\d{3}-\d{3}-\d{4}/;
  if (!phonePattern.test(phone)) {
    alert('Please enter a valid phone number (XXX-XXX-XXXX).');
    return;
  }

  // In a real implementation, you would send this data to a server
  console.log('Form submitted:', Object.fromEntries(formData));

  // Show success message
  const successMessage = document.createElement('div');
  successMessage.className = 'success-message';
  successMessage.innerHTML = `
    <div class="success-content">
      <h3>Thank You!</h3>
      <p>Your free estimate request has been submitted successfully.</p>
      <p>We'll contact you within 24 hours at ${phone} to schedule your estimate.</p>
    </div>
  `;

  // Replace form with success message
  form.style.display = 'none';
  form.parentNode.appendChild(successMessage);
}
</script>